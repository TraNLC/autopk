{
  "name": "gst-auto-pk-node",
  "version": "1.0.2",
  "description": "GST Auto PK - VLTK1 Mobile Automation Tool (Node.js Rewrite)",
  "main": "src/gui/main.js",
  "scripts": {
    "start": "node src/index.js",
    "build:frida": "node frida-scripts/build.js",
    "build:frida:bridge": "node frida-scripts/build.js --bridge",
    "watchdog": "node src/game-watchdog.js",
    "test:adb": "node test/test-adb.js",
    "test:frida": "node test/test-frida.js",
    "test:memory": "node test/test-memory.js",
    "test:packet": "node test/test-packet.js",
    "gui": "electron src/gui/main.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "adbkit": "^2.11.1",
    "frida": "^17.10.1",
    "frida-compile": "^19.0.5",
    "frida-il2cpp-bridge": "^0.13.1",
    "systeminformation": "^5.31.11"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "author": "GST",
  "license": "MIT",
  "build": {
    "appId": "com.gst.autopk",
    "productName": "GST Auto PK",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    },
    "files": [
      "src/**/*",
      "config.js",
      "package.json",
      "frida-scripts/**/*",
      "data/**/*"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!frida-server",
          "!frida-server-x86_64"
        ]
      }
    ],
    "asar": true
  }
}
